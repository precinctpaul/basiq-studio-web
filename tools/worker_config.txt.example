# Copy this file to worker_config.txt and fill in the three values below.
# No quotes needed even if a path has spaces -- everything after the first
# "=" on a line is taken literally as the value.
#
# worker_config.txt is gitignored: it holds your auth token, never commit it.

# The cloud agent's public URL (see tools/build/deploy/SETUP.md).
# No trailing slash.
AGENT_URL=https://basiq.51st.media/agent

# Must match the AUTH_TOKEN the cloud agent is configured with, exactly.
AUTH_TOKEN=

# This machine's path to the SAME shared drive the cloud agent writes to --
# must resolve to the Archive/Basiq-Studio-Hub folder itself, not the wider
# drive it lives under.
# Windows example: C:\Volumes\md-pac\media\Archive\Basiq-Studio-Hub
# Mac example: /Volumes/md-pac/media/Archive/Basiq-Studio-Hub
MEDIA_ROOT=

# The worker imports basiq_agent.py and calls its run_grab()/run_live_capture()
# functions directly on THIS machine -- including the final DB write that
# registers the finished video in the library. Without these two set here,
# that write fails silently: the job still reports "Complete" and the file
# still lands on the shared drive, but the video never appears in the app.
# Same values as SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY in the web app's
# .env.local (Supabase dashboard -> Settings -> Data API / API Keys).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional, only needed if YouTube grabs on this machine start failing with
# "Sign in to confirm you're not a bot": path to a cookies.txt file exported
# from a real, currently-logged-in-to-YouTube browser (e.g. via the "Get
# cookies.txt LOCALLY" extension). Being on a residential connection isn't
# always enough on its own -- this is a real per-video authentication check,
# confirmed by hitting it even from a non-datacenter machine. Re-export and
# replace this file whenever grabs start failing again; exported cookies
# expire.
# Windows example: C:\Users\yourname\Documents\cookies.txt
COOKIES_FILE=
