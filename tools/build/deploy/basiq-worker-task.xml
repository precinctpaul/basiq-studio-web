<?xml version="1.0" encoding="UTF-8"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Starts the Basiq Studio capture worker (tools/start-worker.bat) at logon and restarts it automatically if it ever exits unexpectedly. See tools/build/deploy/SETUP.md, Step 10.</Description>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <!-- Task Scheduler kills a task after 72 hours by default (ExecutionTimeLimit).
         This worker is meant to run indefinitely, so that default is disabled here
         (PT0S = no limit): without this line, the worker would be silently
         force-killed every 3 days regardless of anything else going right. -->
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
    <!-- Restarts the task if its process exits unexpectedly (crash, kill, OOM),
         up to 999 times, 1 minute apart. This does NOT help if start-worker.bat's
         own guard checks fail and it sits at a `pause` prompt instead of actually
         exiting (missing config, .venv not installed): that still needs a human
         to notice the window. See SETUP.md's "Always-on later" section. -->
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>999</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>start-worker.bat</Command>
      <!-- EDIT THIS before importing: this machine's actual path to tools/,
           wherever the worker's local install actually lives (see
           tools/README.md / Basiq-Setup.bat), not necessarily this example. -->
      <WorkingDirectory>C:\PATH\TO\basiq-studio-web\tools</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
