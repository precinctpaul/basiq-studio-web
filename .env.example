# Basiq Studio Hub - web
# Copy to .env.local and fill in. .env.local is gitignored; this file is not.

# ---------------------------------------------------------------------------
# Supabase
# Project: basiq_studio_hub  (ref tijwokimlrglufjqiwok, region ca-central-1)
# ---------------------------------------------------------------------------

# Dashboard -> Settings -> Data API. Derived from the project ref.
NEXT_PUBLIC_SUPABASE_URL=https://tijwokimlrglufjqiwok.supabase.co

# Dashboard -> Settings -> API Keys -> publishable key (sb_publishable_...),
# or the legacy "anon" JWT under Settings -> JWT Keys.
# Safe to ship to the browser. With the deny-all RLS in migration 0001 this
# key can read and write nothing on its own - which is the point.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dashboard -> Settings -> API Keys -> secret key (sb_secret_...),
# or the legacy "service_role" JWT under Settings -> JWT Keys.
#
# THIS KEY BYPASSES EVERY ACCESS RULE IN THE DATABASE.
# Server-side only. Never prefix it with NEXT_PUBLIC_, never import it into a
# client component, never paste it into a chat window or an issue tracker.
# If it leaks, rotate it in the dashboard immediately.
SUPABASE_SERVICE_ROLE_KEY=


# ---------------------------------------------------------------------------
# Local Whisper server
# ---------------------------------------------------------------------------
# Where the user's own machine is serving transcription. Public default; each
# user can override it in the UI. See tools/README.md for local setup, or
# tools/build/README.md for remote deployment.
NEXT_PUBLIC_WHISPER_URL=http://127.0.0.1:8000

# Auth token for remote agent deployment. When the agent is behind auth
# (remote server), set this to the AUTH_TOKEN the server is configured with.
# Unset for localhost development (no auth required).
NEXT_PUBLIC_WHISPER_AUTH_TOKEN=

# This machine's path to the Archive/Basiq-Studio-Hub folder itself (not the
# wider shared drive it lives under) -- read at runtime by /api/transcribe,
# which writes uploaded files directly there. Must match whatever MEDIA_ROOT
# the local agent (tools/basiq_agent.py) and worker (tools/basiq_worker.py)
# are configured with, exactly.
# Windows example: C:\Volumes\md-pac\media\Archive\Basiq-Studio-Hub
# Mac example: /Volumes/md-pac/media/Archive/Basiq-Studio-Hub
MEDIA_ROOT=
