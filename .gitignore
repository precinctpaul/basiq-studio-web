# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local whisper server (tools/README.md) — each user creates their own venv
# and model cache; neither belongs in version control
tools/.venv
tools/whisper_cache
tools/__pycache__

# worker role's own venv (tools/requirements-worker.txt) — same reasoning as
# tools/.venv above, deliberately a separate one (see that file's header)
tools/.venv-worker

# youtube_session.py's persistent browser profile and Playwright's own
# downloaded Chrome binary cache — more sensitive than tools/cookies.txt
# (a whole live, cookie-authenticated browser profile, not just an export),
# and this repo has already had one real cookie-leak incident (2026-08-25)
tools/youtube_profile
tools/ms-playwright

# basiq_worker.py's status file and basiq_worker_tray.py's log dir — runtime
# state, machine-local, regenerated on every run
tools/worker_status.json
tools/logs

# the four shared secrets (AGENT_URL/AUTH_TOKEN/SUPABASE_URL/
# SUPABASE_SERVICE_ROLE_KEY) for installer_worker.iss's config merge — lives
# on the shared drive next to Basiq-Worker-Setup.exe, never in the repo
tools/build/worker_config.seed.txt
tools/worker_config.seed.txt

# basiq_worker.py singleton PID lock — runtime state, machine-local
tools/worker.lock

# basiq_agent.py's persistent job-error log — runtime state, machine-local
tools/job_errors.jsonl

# test fixtures generated on the fly / smoke-test scratch output
tests/_smoke_*.mp4
tests/fixtures/*.wav

# typescript
*.tsbuildinfo
next-env.d.ts

# ...but keep the committed template.
!.env.example
tools/hf_cache
tools/media
tools/media_root.txt
tools/worker_config.txt
tools/cookies.txt
tools/cookies.txt.working

# real per-user YouTube/Google auth cookies -- a root-level copy of this
# somehow got committed and pushed to this repo's public GitHub remote
# (2026-08-25); removed from tracking 2026-09-09, ignored going forward so
# it can't happen again from a stray `git add .` at the repo root
/cookies.txt

# archive_consolidation (Congress video archive person/metadata resolution) —
# output/ is entirely regeneratable from the scripts + the source archive
# (SRTs, metadata.json exports, the working SQLite index, CSV reviews —
# ~950MB across 16k+ files as of writing). Only the scripts themselves are
# the actual deliverable; the data must never be committed, since git keeps
# every byte of history forever even after a later deletion.
tools/archive_consolidation/output
tools/archive_consolidation/__pycache__

# User's own working data for the same archive-consolidation effort (543MB+) —
# same reasoning as above: working data, not source, never committed.
tools/FilteredCSVs

# PyInstaller/Inno Setup build output (tools/build/README.md) — regenerated
# by build_windows.bat / build_macos.sh, multiple GB, never committed
tools/build/dist
tools/build/work
tools/build/installer_output
tools/build/*.log
