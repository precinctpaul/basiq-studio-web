# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local whisper server (tools/README.md) — each user creates their own venv
# and model cache; neither belongs in version control
tools/.venv
tools/whisper_cache
tools/__pycache__

# basiq_worker.py singleton PID lock + heartbeat — runtime state, machine-local
tools/worker.lock
tools/worker_heartbeat.txt

# worker_tray.py's own singleton lock + log — runtime state, machine-local
tools/worker_tray.lock
tools/worker_tray.log

# pipeline_doctor.py's own singleton lock + log — runtime state, machine-local
tools/pipeline_doctor.lock
tools/pipeline_doctor.log

# basiq_agent.py's persistent job-error log — runtime state, machine-local
tools/job_errors.jsonl

# test fixtures generated on the fly / smoke-test scratch output
tests/_smoke_*.mp4
tests/fixtures/*.wav

# typescript
*.tsbuildinfo
next-env.d.ts

# ...but keep the committed template.
!.env.example
tools/hf_cache
tools/media
tools/media_root.txt
tools/worker_config.txt
tools/cookies.txt
tools/cookies.txt.working
tools/cookies.txt.bak-*

# A real Chrome profile (leveldb, cache, etc.) a browser-refreshed cookie
# session feature keeps alive locally -- machine-local runtime state, and
# critically, its leveldb LOCK file being exclusively held while that
# process runs was enough to crash Turbopack's dev server outright: Tailwind
# v4's zero-config content auto-detection scans the whole project (minus
# .gitignore) for class usage, and choked trying to read through the lock
# (confirmed 2026-09-10 -- nothing about this directory's actual content,
# purely an artifact of it being scannable at all).
tools/youtube_profile
tools/worker_status.json

# real per-user YouTube/Google auth cookies -- a root-level copy of this
# somehow got committed and pushed to this repo's public GitHub remote
# (2026-08-25); removed from tracking 2026-09-09, ignored going forward so
# it can't happen again from a stray `git add .` at the repo root
/cookies.txt

# archive_consolidation (Congress video archive person/metadata resolution) —
# output/ is entirely regeneratable from the scripts + the source archive
# (SRTs, metadata.json exports, the working SQLite index, CSV reviews —
# ~950MB across 16k+ files as of writing). Only the scripts themselves are
# the actual deliverable; the data must never be committed, since git keeps
# every byte of history forever even after a later deletion.
tools/archive_consolidation/output
tools/archive_consolidation/__pycache__

# User's own working data for the same archive-consolidation effort (543MB+) —
# same reasoning as above: working data, not source, never committed.
tools/FilteredCSVs

# PyInstaller/Inno Setup build output (tools/build/README.md) — regenerated
# by build_windows.bat / build_macos.sh, multiple GB, never committed
tools/build/dist
tools/build/work
tools/build/installer_output
tools/build/*.log
